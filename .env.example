APP_NAME=Multilingual Citizen Grievance Chatbot
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-long-random-value

# SQLite works without PostgreSQL. Use PostgreSQL for the full deployment.
DATABASE_URL=sqlite:///./grievance.db
# DATABASE_URL=postgresql+psycopg://grievance:grievance@localhost:5432/grievance
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ALLOWED_HOSTS=127.0.0.1,localhost

TELEGRAM_BOT_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

CLASSIFICATION_CONFIDENCE_THRESHOLD=0.55
DEMO_SLA_MINUTES=2
ESCALATION_INTERVAL_MINUTES=5
ENABLE_VOICE=false
WHISPER_MODEL=small
MAX_VOICE_UPLOAD_MB=10
MAX_REQUEST_BODY_MB=12
ENABLE_AI_ROUTING=false
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_API_URL=https://api.sarvam.ai/v1/chat/completions
AI_ROUTING_TIMEOUT_SECONDS=12
ENABLE_TRANSLATION=false
TRANSLATION_EXTERNAL_FALLBACK=false
ENABLE_LANGCHAIN=false
ENABLE_ML_CLASSIFIER=true
CLASSIFIER_MODEL_PATH=ml/models/classifier.joblib
MODEL_DIR=ml/models
EMBEDDING_MODEL=intfloat/multilingual-e5-small
TRANSLATION_MODEL=ai4bharat/indictrans2-indic-en-dist-200M
